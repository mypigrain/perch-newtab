{
  "manifest_version": 3,
  "name": "栖 Perch · 新标签页",
  "short_name": "栖 Perch",
  "version": "0.8.0",
  "description": "液态玻璃新标签页：固定 / 项目 / 偶尔用三分区，磁贴自由摆放。玻璃由透镜 Lens 设计系统实时折射渲染。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "offline_enabled": true
}
